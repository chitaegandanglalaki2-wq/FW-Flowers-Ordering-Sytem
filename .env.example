SECRET_KEY=replace-with-a-random-secret-key
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false

DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fuzzywirebouquet

# Optional fallback address; the saved Admin > Shop Location address takes priority.
SHOP_LOCATION_ADDRESS=your exact shop street and barangay,Cavinti,Laguna,Philippines
# Legacy coordinate fallback only. Admins set the location by address in the sidebar.
SHOP_LOCATION_LATITUDE=
SHOP_LOCATION_LONGITUDE=
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=FuzzyWireBouquet/1.0
ROUTING_URL=https://router.project-osrm.org

# Para sa lokal na testing
BASE_URL=http://127.0.0.1:5000

# Ilagay ang tunay na GCash details ng shop.
GCASH_ACCOUNT_NAME=PALITAN_NG_GCASH_ACCOUNT_NAME
GCASH_NUMBER=PALITAN_NG_GCASH_NUMBER

# Gmail sender
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com